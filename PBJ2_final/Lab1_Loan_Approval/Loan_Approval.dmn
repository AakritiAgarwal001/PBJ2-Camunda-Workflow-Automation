<?xml version='1.0' encoding='utf-8'?>
<ns0:definitions xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:ns0="https://www.omg.org/spec/DMN/20191111/MODEL/" id="Definitions_loanEligibilityDecision" name="Loan Eligibility Decision" namespace="http://camunda.org/schema/1.0/dmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <ns0:decision id="loanEligibilityDecision" name="Loan Eligibility Decision">
    <ns0:decisionTable id="DecisionTable_loanEligibilityDecision" hitPolicy="FIRST">
      <ns0:input id="Input_1" label="Credit score">
        <ns0:inputExpression id="InputExpression_1" typeRef="number">
          <ns0:text>creditAssessment.creditScore</ns0:text>
        </ns0:inputExpression>
      </ns0:input>
      <ns0:input id="Input_2" label="Monthly income">
        <ns0:inputExpression id="InputExpression_2" typeRef="number">
          <ns0:text>monthlyIncome</ns0:text>
        </ns0:inputExpression>
      </ns0:input>
      <ns0:input id="Input_3" label="Loan amount / monthly income">
        <ns0:inputExpression id="InputExpression_3" typeRef="number">
          <ns0:text>requestedLoanAmount / monthlyIncome</ns0:text>
        </ns0:inputExpression>
      </ns0:input>
      <ns0:input id="Input_4" label="Employment status">
        <ns0:inputExpression id="InputExpression_4" typeRef="string">
          <ns0:text>employmentStatus</ns0:text>
        </ns0:inputExpression>
      </ns0:input>
      <ns0:output id="Output_1" name="loanEligibilityDecision" label="Loan decision" typeRef="string" />
      <ns0:rule id="Rule_1">
        <ns0:description>Reject very low credit scores.</ns0:description>
        <ns0:inputEntry id="Rule_1_Input_1">
          <ns0:text>&lt; 500</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="Rule_1_Input_2">
          <ns0:text>-</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="Rule_1_Input_3">
          <ns0:text>-</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="Rule_1_Input_4">
          <ns0:text>-</ns0:text>
        </ns0:inputEntry>
        <ns0:outputEntry id="Rule_1_Output">
          <ns0:text>"REJECTED"</ns0:text>
        </ns0:outputEntry>
      </ns0:rule>
      <ns0:rule id="Rule_2">
        <ns0:description>Reject income below the educational minimum.</ns0:description>
        <ns0:inputEntry id="Rule_2_Input_1">
          <ns0:text>-</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="Rule_2_Input_2">
          <ns0:text>&lt; 20000</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="Rule_2_Input_3">
          <ns0:text>-</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="Rule_2_Input_4">
          <ns0:text>-</ns0:text>
        </ns0:inputEntry>
        <ns0:outputEntry id="Rule_2_Output">
          <ns0:text>"REJECTED"</ns0:text>
        </ns0:outputEntry>
      </ns0:rule>
      <ns0:rule id="Rule_3">
        <ns0:description>Strong score, sufficient income, manageable loan-to-income ratio, salaried.</ns0:description>
        <ns0:inputEntry id="Rule_3_Input_1">
          <ns0:text>&gt;= 750</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="Rule_3_Input_2">
          <ns0:text>&gt;= 20000</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="Rule_3_Input_3">
          <ns0:text>&lt;= 12</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="Rule_3_Input_4">
          <ns0:text>"SALARIED"</ns0:text>
        </ns0:inputEntry>
        <ns0:outputEntry id="Rule_3_Output">
          <ns0:text>"APPROVED"</ns0:text>
        </ns0:outputEntry>
      </ns0:rule>
      <ns0:rule id="Rule_4">
        <ns0:description>Standard approval for qualifying salaried or self-employed applicants.</ns0:description>
        <ns0:inputEntry id="Rule_4_Input_1">
          <ns0:text>&gt;= 650</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="Rule_4_Input_2">
          <ns0:text>&gt;= 20000</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="Rule_4_Input_3">
          <ns0:text>&lt;= 18</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="Rule_4_Input_4">
          <ns0:text>"SALARIED", "SELF_EMPLOYED"</ns0:text>
        </ns0:inputEntry>
        <ns0:outputEntry id="Rule_4_Output">
          <ns0:text>"APPROVED"</ns0:text>
        </ns0:outputEntry>
      </ns0:rule>
      <ns0:rule id="Rule_5">
        <ns0:description>All other eligible-but-borderline cases require human review.</ns0:description>
        <ns0:inputEntry id="Rule_5_Input_1">
          <ns0:text>-</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="Rule_5_Input_2">
          <ns0:text>-</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="Rule_5_Input_3">
          <ns0:text>-</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="Rule_5_Input_4">
          <ns0:text>-</ns0:text>
        </ns0:inputEntry>
        <ns0:outputEntry id="Rule_5_Output">
          <ns0:text>"MANUAL_REVIEW"</ns0:text>
        </ns0:outputEntry>
      </ns0:rule>
    </ns0:decisionTable>
  </ns0:decision>
</ns0:definitions>