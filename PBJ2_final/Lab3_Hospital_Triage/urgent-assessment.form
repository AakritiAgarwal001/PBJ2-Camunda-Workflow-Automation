{
  "id": "urgent-assessment-form",
  "type": "default",
  "components": [
    {
      "type": "select",
      "key": "assessmentDisposition",
      "label": "Assessment disposition",
      "validate": {
        "required": true
      },
      "values": [
        {
          "label": "Assessment initiated",
          "value": "ASSESSMENT_INITIATED"
        },
        {
          "label": "Escalate now",
          "value": "ESCALATED"
        }
      ]
    },
    {
      "type": "textarea",
      "key": "assessmentNotes",
      "label": "Synthetic staff assessment notes",
      "validate": {
        "required": true
      }
    }
  ],
  "schemaVersion": 18,
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0"
}