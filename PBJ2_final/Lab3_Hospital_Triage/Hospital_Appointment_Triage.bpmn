<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns2="http://camunda.org/schema/zeebe/1.0" xmlns:ns4="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns5="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns6="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ns1="http://camunda.org/schema/modeler/1.0" id="Definitions_hospitalTriageProcess" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1" ns1:executionPlatform="Camunda Cloud" ns1:executionPlatformVersion="8.9.0">
  <bpmn:process id="hospitalTriageProcess" name="Hospital Appointment and Patient Triage" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Patient" name="Appointment request started">
      <bpmn:outgoing>Flow_Patient_Start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_RegisterPatient" name="Register synthetic patient">
      <bpmn:documentation>Use synthetic patient reference and educational triage fields only. Do not enter real patient data.</bpmn:documentation>
      <bpmn:extensionElements>
        <ns2:formDefinition formId="patient-registration-form" />
        <ns2:assignmentDefinition candidateGroups="registration-staff" />
        <ns2:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Patient_Start</bpmn:incoming>
      <bpmn:outgoing>Flow_Register_Validate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ValidateRegistration" name="Validate registration details">
      <bpmn:documentation>Spring Boot worker validates required registration and triage input.</bpmn:documentation>
      <bpmn:extensionElements>
        <ns2:taskDefinition type="validate-registration" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Register_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_Validate_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_RegistrationValid" name="Registration valid?" default="Flow_RegistrationInvalid">
      <bpmn:incoming>Flow_Validate_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_RegistrationValid</bpmn:outgoing>
      <bpmn:outgoing>Flow_RegistrationInvalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Task_ClassifyTriage" name="Classify triage category (DMN)">
      <bpmn:documentation>Educational DMN returns ROUTINE, PRIORITY_REVIEW, or URGENT_ASSESSMENT.</bpmn:documentation>
      <bpmn:extensionElements>
        <ns2:calledDecision decisionId="triageDecision" resultVariable="triageCategory" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RegistrationValid</bpmn:incoming>
      <bpmn:outgoing>Flow_DMN_Gateway</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_Triage" name="Triage category?" default="Flow_Routine">
      <bpmn:incoming>Flow_DMN_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Urgent</bpmn:outgoing>
      <bpmn:outgoing>Flow_Priority</bpmn:outgoing>
      <bpmn:outgoing>Flow_Routine</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_UrgentAssessment" name="Immediate urgent staff assessment">
      <bpmn:documentation>Urgent educational category is routed directly to a human assessment task.</bpmn:documentation>
      <bpmn:extensionElements>
        <ns2:formDefinition formId="urgent-assessment-form" />
        <ns2:assignmentDefinition candidateGroups="clinical-reviewers" />
        <ns2:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Urgent</bpmn:incoming>
      <bpmn:outgoing>Flow_Urgent_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PriorityReview" name="Priority staff review">
      <bpmn:documentation>Authorised staff review the priority request and decide whether to schedule.</bpmn:documentation>
      <bpmn:extensionElements>
        <ns2:formDefinition formId="priority-review-form" />
        <ns2:assignmentDefinition candidateGroups="clinical-reviewers" />
        <ns2:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Priority</bpmn:incoming>
      <bpmn:outgoing>Flow_Priority_Gateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_PriorityOutcome" name="Priority review outcome?" default="Flow_Priority_Escalate">
      <bpmn:incoming>Flow_Priority_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Priority_Proceed</bpmn:outgoing>
      <bpmn:outgoing>Flow_Priority_Escalate</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_PrecheckAvailability" name="Pre-check appointment availability (Java worker)">
      <bpmn:extensionElements>
        <ns2:taskDefinition type="check-appointment-availability" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Routine</bpmn:incoming>
      <bpmn:incoming>Flow_Priority_Proceed</bpmn:incoming>
      <bpmn:outgoing>Flow_Precheck_To_Rest</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CheckSlots" name="Check appointment slots (REST)">
      <bpmn:documentation>Calls the mock scheduling API and maps the slots and availability into process variables.</bpmn:documentation>
      <bpmn:extensionElements>
        <ns2:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <ns2:ioMapping>
          <ns2:input source="noAuth" target="authentication.type" />
          <ns2:input source="= &#34;POST&#34;" target="method" />
          <ns2:input source="= &#34;http://localhost:8081/api/appointments/check&#34;" target="url" />
          <ns2:input source="= { &#34;Content-Type&#34;: &#34;application/json&#34; }" target="headers" />
          <ns2:input source="= { &#34;patientRef&#34;: patientRef, &#34;appointmentPreference&#34;: appointmentPreference, &#34;forceNoSlots&#34;: forceNoSlots, &#34;simulateFailure&#34;: simulateSchedulingFailure }" target="body" />
          <ns2:input source="= 10" target="connectionTimeoutInSeconds" />
          <ns2:input source="= 20" target="readTimeoutInSeconds" />
        </ns2:ioMapping>
        <ns2:taskHeaders>
          <ns2:header key="resultExpression" value="={appointmentAvailable: response.body.available, availableSlots: response.body.slots, schedulingStatus: response.body.bookingStatus}" />
        </ns2:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Precheck_To_Rest</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckSlots_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Slots" name="Appointment slot available?" default="Flow_NoSlots">
      <bpmn:incoming>Flow_CheckSlots_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_SlotAvailable</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoSlots</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_SelectSlot" name="Select appointment slot">
      <bpmn:documentation>Select one of the returned availableSlots values in Tasklist.</bpmn:documentation>
      <bpmn:extensionElements>
        <ns2:formDefinition formId="select-appointment-form" />
        <ns2:assignmentDefinition candidateGroups="scheduling-staff" />
        <ns2:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SlotAvailable</bpmn:incoming>
      <bpmn:outgoing>Flow_Select_Book</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_BookAppointment" name="Book selected appointment (REST)">
      <bpmn:documentation>Books the selected synthetic slot through the mock scheduling API.</bpmn:documentation>
      <bpmn:extensionElements>
        <ns2:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <ns2:ioMapping>
          <ns2:input source="noAuth" target="authentication.type" />
          <ns2:input source="= &#34;POST&#34;" target="method" />
          <ns2:input source="= &#34;http://localhost:8081/api/appointments/book&#34;" target="url" />
          <ns2:input source="= { &#34;Content-Type&#34;: &#34;application/json&#34; }" target="headers" />
          <ns2:input source="= { &#34;patientRef&#34;: patientRef, &#34;selectedSlot&#34;: selectedSlot, &#34;appointmentPreference&#34;: appointmentPreference, &#34;simulateFailure&#34;: simulateSchedulingFailure }" target="body" />
          <ns2:input source="= 10" target="connectionTimeoutInSeconds" />
          <ns2:input source="= 20" target="readTimeoutInSeconds" />
        </ns2:ioMapping>
        <ns2:taskHeaders>
          <ns2:header key="resultExpression" value="={bookingStatus: response.body.bookingStatus, bookingReference: response.body.bookingReference}" />
        </ns2:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Select_Book</bpmn:incoming>
      <bpmn:outgoing>Flow_Book_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Booking" name="Booking successful?" default="Flow_BookingFailed">
      <bpmn:incoming>Flow_Book_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Booked</bpmn:outgoing>
      <bpmn:outgoing>Flow_BookingFailed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_NoSlotReview" name="Staff review – no suitable slot">
      <bpmn:documentation>Tasklist follow-up when no slot is available or booking fails.</bpmn:documentation>
      <bpmn:extensionElements>
        <ns2:formDefinition formId="no-slot-review-form" />
        <ns2:assignmentDefinition candidateGroups="scheduling-staff" />
        <ns2:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NoSlots</bpmn:incoming>
      <bpmn:incoming>Flow_BookingFailed</bpmn:incoming>
      <bpmn:outgoing>Flow_NoSlot_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Booked" name="Appointment booked">
      <bpmn:incoming>Flow_Booked</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Urgent" name="Urgent assessment routed to staff">
      <bpmn:incoming>Flow_Urgent_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_PriorityEscalated" name="Priority case escalated">
      <bpmn:incoming>Flow_Priority_Escalate</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_NoSlot" name="Manual scheduling follow-up required">
      <bpmn:incoming>Flow_NoSlot_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Invalid" name="Registration incomplete">
      <bpmn:incoming>Flow_RegistrationInvalid</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Patient_Start" sourceRef="StartEvent_Patient" targetRef="Task_RegisterPatient" />
    <bpmn:sequenceFlow id="Flow_Register_Validate" sourceRef="Task_RegisterPatient" targetRef="Task_ValidateRegistration" />
    <bpmn:sequenceFlow id="Flow_Validate_Gateway" sourceRef="Task_ValidateRegistration" targetRef="Gateway_RegistrationValid" />
    <bpmn:sequenceFlow id="Flow_RegistrationValid" name="Valid" sourceRef="Gateway_RegistrationValid" targetRef="Task_ClassifyTriage">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= registrationValid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RegistrationInvalid" name="Invalid" sourceRef="Gateway_RegistrationValid" targetRef="End_Invalid" />
    <bpmn:sequenceFlow id="Flow_DMN_Gateway" sourceRef="Task_ClassifyTriage" targetRef="Gateway_Triage" />
    <bpmn:sequenceFlow id="Flow_Urgent" name="Urgent" sourceRef="Gateway_Triage" targetRef="Task_UrgentAssessment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= triageCategory = "URGENT_ASSESSMENT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Priority" name="Priority" sourceRef="Gateway_Triage" targetRef="Task_PriorityReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= triageCategory = "PRIORITY_REVIEW"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Routine" name="Routine" sourceRef="Gateway_Triage" targetRef="Task_PrecheckAvailability" />
    <bpmn:sequenceFlow id="Flow_Urgent_End" sourceRef="Task_UrgentAssessment" targetRef="End_Urgent" />
    <bpmn:sequenceFlow id="Flow_Priority_Gateway" sourceRef="Task_PriorityReview" targetRef="Gateway_PriorityOutcome" />
    <bpmn:sequenceFlow id="Flow_Priority_Proceed" name="Proceed to scheduling" sourceRef="Gateway_PriorityOutcome" targetRef="Task_PrecheckAvailability">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= priorityOutcome = "PROCEED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Priority_Escalate" name="Escalate / defer" sourceRef="Gateway_PriorityOutcome" targetRef="End_PriorityEscalated" />
    <bpmn:sequenceFlow id="Flow_Precheck_To_Rest" sourceRef="Task_PrecheckAvailability" targetRef="Task_CheckSlots" />
    <bpmn:sequenceFlow id="Flow_CheckSlots_Gateway" sourceRef="Task_CheckSlots" targetRef="Gateway_Slots" />
    <bpmn:sequenceFlow id="Flow_SlotAvailable" name="Available" sourceRef="Gateway_Slots" targetRef="Task_SelectSlot">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= appointmentAvailable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoSlots" name="No slots" sourceRef="Gateway_Slots" targetRef="Task_NoSlotReview" />
    <bpmn:sequenceFlow id="Flow_Select_Book" sourceRef="Task_SelectSlot" targetRef="Task_BookAppointment" />
    <bpmn:sequenceFlow id="Flow_Book_Gateway" sourceRef="Task_BookAppointment" targetRef="Gateway_Booking" />
    <bpmn:sequenceFlow id="Flow_Booked" name="Booked" sourceRef="Gateway_Booking" targetRef="End_Booked">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= bookingStatus = "BOOKED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_BookingFailed" name="Booking failed" sourceRef="Gateway_Booking" targetRef="Task_NoSlotReview" />
    <bpmn:sequenceFlow id="Flow_NoSlot_End" sourceRef="Task_NoSlotReview" targetRef="End_NoSlot" />
  </bpmn:process>
  <ns4:BPMNDiagram id="Diagram_hospitalTriageProcess">
    <ns4:BPMNPlane id="Plane_hospitalTriageProcess" bpmnElement="hospitalTriageProcess">
      <ns4:BPMNShape id="Shape_StartEvent_Patient" bpmnElement="StartEvent_Patient">
        <ns5:Bounds x="172" y="322" width="36" height="36" />
        <ns4:BPMNLabel>
          <ns5:Bounds x="153" y="358" width="74" height="27" />
        </ns4:BPMNLabel>
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_Task_RegisterPatient" bpmnElement="Task_RegisterPatient">
        <ns5:Bounds x="310" y="290" width="205" height="100" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_Task_ValidateRegistration" bpmnElement="Task_ValidateRegistration">
        <ns5:Bounds x="570" y="300" width="195" height="85" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_Gateway_RegistrationValid" bpmnElement="Gateway_RegistrationValid" isMarkerVisible="true">
        <ns5:Bounds x="830" y="320" width="50" height="50" />
        <ns4:BPMNLabel>
          <ns5:Bounds x="824" y="286" width="62" height="27" />
        </ns4:BPMNLabel>
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_Task_ClassifyTriage" bpmnElement="Task_ClassifyTriage">
        <ns5:Bounds x="950" y="300" width="210" height="85" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_Gateway_Triage" bpmnElement="Gateway_Triage" isMarkerVisible="true">
        <ns5:Bounds x="1220" y="320" width="50" height="50" />
        <ns4:BPMNLabel>
          <ns5:Bounds x="1258" y="363" width="83" height="14" />
        </ns4:BPMNLabel>
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_Task_UrgentAssessment" bpmnElement="Task_UrgentAssessment">
        <ns5:Bounds x="1290" y="77" width="220" height="105" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_Task_PriorityReview" bpmnElement="Task_PriorityReview">
        <ns5:Bounds x="1340" y="690" width="190" height="100" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_Gateway_PriorityOutcome" bpmnElement="Gateway_PriorityOutcome" isMarkerVisible="true">
        <ns5:Bounds x="1590" y="715" width="50" height="50" />
        <ns4:BPMNLabel>
          <ns5:Bounds x="1635" y="726" width="70" height="27" />
        </ns4:BPMNLabel>
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_Task_PrecheckAvailability" bpmnElement="Task_PrecheckAvailability">
        <ns5:Bounds x="1507" y="300" width="205" height="90" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_Task_CheckSlots" bpmnElement="Task_CheckSlots">
        <ns5:Bounds x="1762" y="300" width="215" height="100" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_Gateway_Slots" bpmnElement="Gateway_Slots" isMarkerVisible="true">
        <ns5:Bounds x="2037" y="320" width="50" height="50" />
        <ns4:BPMNLabel>
          <ns5:Bounds x="2086" y="356" width="82" height="27" />
        </ns4:BPMNLabel>
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_Task_SelectSlot" bpmnElement="Task_SelectSlot">
        <ns5:Bounds x="2135" y="210" width="190" height="100" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_Task_BookAppointment" bpmnElement="Task_BookAppointment">
        <ns5:Bounds x="2370" y="210" width="220" height="100" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_Gateway_Booking" bpmnElement="Gateway_Booking" isMarkerVisible="true">
        <ns5:Bounds x="2687" y="244" width="50" height="50" />
        <ns4:BPMNLabel>
          <ns5:Bounds x="2683" y="206.5" width="58" height="27" />
        </ns4:BPMNLabel>
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_Task_NoSlotReview" bpmnElement="Task_NoSlotReview">
        <ns5:Bounds x="2187" y="510" width="215" height="105" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_End_Booked" bpmnElement="End_Booked">
        <ns5:Bounds x="2882" y="251" width="36" height="36" />
        <ns4:BPMNLabel>
          <ns5:Bounds x="2869" y="296" width="62" height="27" />
        </ns4:BPMNLabel>
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_End_Urgent" bpmnElement="End_Urgent">
        <ns5:Bounds x="1622" y="112" width="36" height="36" />
        <ns4:BPMNLabel>
          <ns5:Bounds x="1606" y="160" width="68" height="40" />
        </ns4:BPMNLabel>
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_End_PriorityEscalated" bpmnElement="End_PriorityEscalated">
        <ns5:Bounds x="1810" y="807" width="36" height="36" />
        <ns4:BPMNLabel>
          <ns5:Bounds x="1797" y="856" width="61" height="27" />
        </ns4:BPMNLabel>
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_End_NoSlot" bpmnElement="End_NoSlot">
        <ns5:Bounds x="2277" y="702" width="36" height="36" />
        <ns4:BPMNLabel>
          <ns5:Bounds x="2251" y="740" width="88" height="40" />
        </ns4:BPMNLabel>
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_End_Invalid" bpmnElement="End_Invalid">
        <ns5:Bounds x="837" y="722" width="36" height="36" />
        <ns4:BPMNLabel>
          <ns5:Bounds x="825" y="768" width="75" height="27" />
        </ns4:BPMNLabel>
      </ns4:BPMNShape>
      <ns4:BPMNEdge id="Edge_Flow_Patient_Start" bpmnElement="Flow_Patient_Start">
        <ns6:waypoint x="208" y="340" />
        <ns6:waypoint x="310" y="340" />
      </ns4:BPMNEdge>
      <ns4:BPMNEdge id="Edge_Flow_Register_Validate" bpmnElement="Flow_Register_Validate">
        <ns6:waypoint x="515" y="340" />
        <ns6:waypoint x="570" y="342" />
      </ns4:BPMNEdge>
      <ns4:BPMNEdge id="Edge_Flow_Validate_Gateway" bpmnElement="Flow_Validate_Gateway">
        <ns6:waypoint x="765" y="342" />
        <ns6:waypoint x="830" y="345" />
      </ns4:BPMNEdge>
      <ns4:BPMNEdge id="Edge_Flow_RegistrationValid" bpmnElement="Flow_RegistrationValid">
        <ns6:waypoint x="880" y="345" />
        <ns6:waypoint x="950" y="342" />
        <ns4:BPMNLabel>
          <ns5:Bounds x="903" y="319" width="24" height="14" />
        </ns4:BPMNLabel>
      </ns4:BPMNEdge>
      <ns4:BPMNEdge id="Edge_Flow_RegistrationInvalid" bpmnElement="Flow_RegistrationInvalid">
        <ns6:waypoint x="855" y="370" />
        <ns6:waypoint x="855" y="722" />
        <ns4:BPMNLabel>
          <ns5:Bounds x="864" y="537" width="32" height="14" />
        </ns4:BPMNLabel>
      </ns4:BPMNEdge>
      <ns4:BPMNEdge id="Edge_Flow_DMN_Gateway" bpmnElement="Flow_DMN_Gateway">
        <ns6:waypoint x="1160" y="342" />
        <ns6:waypoint x="1220" y="345" />
      </ns4:BPMNEdge>
      <ns4:BPMNEdge id="Edge_Flow_Urgent" bpmnElement="Flow_Urgent">
        <ns6:waypoint x="1245" y="320" />
        <ns6:waypoint x="1245" y="129" />
        <ns6:waypoint x="1290" y="129" />
        <ns4:BPMNLabel>
          <ns5:Bounds x="1203" y="214" width="34" height="14" />
        </ns4:BPMNLabel>
      </ns4:BPMNEdge>
      <ns4:BPMNEdge id="Edge_Flow_Priority" bpmnElement="Flow_Priority">
        <ns6:waypoint x="1245" y="370" />
        <ns6:waypoint x="1245" y="740" />
        <ns6:waypoint x="1340" y="740" />
        <ns4:BPMNLabel>
          <ns5:Bounds x="1252" y="545" width="35" height="14" />
        </ns4:BPMNLabel>
      </ns4:BPMNEdge>
      <ns4:BPMNEdge id="Edge_Flow_Routine" bpmnElement="Flow_Routine">
        <ns6:waypoint x="1270" y="345" />
        <ns6:waypoint x="1507" y="345" />
        <ns4:BPMNLabel>
          <ns5:Bounds x="1370" y="320" width="38" height="14" />
        </ns4:BPMNLabel>
      </ns4:BPMNEdge>
      <ns4:BPMNEdge id="Edge_Flow_Urgent_End" bpmnElement="Flow_Urgent_End">
        <ns6:waypoint x="1510" y="130" />
        <ns6:waypoint x="1622" y="130" />
      </ns4:BPMNEdge>
      <ns4:BPMNEdge id="Edge_Flow_Priority_Gateway" bpmnElement="Flow_Priority_Gateway">
        <ns6:waypoint x="1530" y="740" />
        <ns6:waypoint x="1590" y="740" />
      </ns4:BPMNEdge>
      <ns4:BPMNEdge id="Edge_Flow_Priority_Proceed" bpmnElement="Flow_Priority_Proceed">
        <ns6:waypoint x="1615" y="715" />
        <ns6:waypoint x="1610" y="390" />
        <ns4:BPMNLabel>
