<?xml version='1.0' encoding='utf-8'?>
<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns1="http://camunda.org/schema/modeler/1.0" xmlns:ns2="http://camunda.org/schema/zeebe/1.0" xmlns:ns4="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns5="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns6="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_hospitalTriageProcess" targetNamespace="http://bpmn.io/schema/bpmn" ns1:executionPlatform="Camunda Cloud" ns1:executionPlatformVersion="8.9.0" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <ns0:process id="hospitalTriageProcess" name="Hospital Appointment and Patient Triage" isExecutable="true">
    <ns0:startEvent id="StartEvent_Patient" name="Appointment request started">
      <ns0:outgoing>Flow_Patient_Start</ns0:outgoing>
    </ns0:startEvent>
    <ns0:userTask id="Task_RegisterPatient" name="Register synthetic patient">
      <ns0:documentation>Use synthetic patient reference and educational triage fields only. Do not enter real patient data.</ns0:documentation>
      <ns0:extensionElements>
        <ns2:formDefinition formId="patient-registration-form" bindingType="deployment" />
        <ns2:assignmentDefinition candidateGroups="registration-staff" />
        <ns2:userTask />
      </ns0:extensionElements>
      <ns0:incoming>Flow_Patient_Start</ns0:incoming>
      <ns0:outgoing>Flow_Register_Validate</ns0:outgoing>
    </ns0:userTask>
    <ns0:serviceTask id="Task_ValidateRegistration" name="Validate registration details">
      <ns0:documentation>Spring Boot worker validates required registration and triage input.</ns0:documentation>
      <ns0:extensionElements>
        <ns2:taskDefinition type="validate-registration" retries="3" />
      </ns0:extensionElements>
      <ns0:incoming>Flow_Register_Validate</ns0:incoming>
      <ns0:outgoing>Flow_Validate_Gateway</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gateway_RegistrationValid" name="Registration valid?" default="Flow_RegistrationInvalid">
      <ns0:incoming>Flow_Validate_Gateway</ns0:incoming>
      <ns0:outgoing>Flow_RegistrationValid</ns0:outgoing>
      <ns0:outgoing>Flow_RegistrationInvalid</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:businessRuleTask id="Task_ClassifyTriage" name="Classify triage category (DMN)">
      <ns0:documentation>Educational DMN returns ROUTINE, PRIORITY_REVIEW, or URGENT_ASSESSMENT.</ns0:documentation>
      <ns0:extensionElements>
        <ns2:calledDecision decisionId="triageDecision" resultVariable="triageCategory" />
      </ns0:extensionElements>
      <ns0:incoming>Flow_RegistrationValid</ns0:incoming>
      <ns0:outgoing>Flow_DMN_Gateway</ns0:outgoing>
    </ns0:businessRuleTask>
    <ns0:exclusiveGateway id="Gateway_Triage" name="Triage category?" default="Flow_Routine">
      <ns0:incoming>Flow_DMN_Gateway</ns0:incoming>
      <ns0:outgoing>Flow_Urgent</ns0:outgoing>
      <ns0:outgoing>Flow_Priority</ns0:outgoing>
      <ns0:outgoing>Flow_Routine</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="Task_UrgentAssessment" name="Immediate urgent staff assessment">
      <ns0:documentation>Urgent educational category is routed directly to a human assessment task.</ns0:documentation>
      <ns0:extensionElements>
        <ns2:formDefinition formId="urgent-assessment-form" bindingType="deployment" />
        <ns2:assignmentDefinition candidateGroups="clinical-reviewers" />
        <ns2:userTask />
      </ns0:extensionElements>
      <ns0:incoming>Flow_Urgent</ns0:incoming>
      <ns0:outgoing>Flow_Urgent_End</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_PriorityReview" name="Priority staff review">
      <ns0:documentation>Authorised staff review the priority request and decide whether to schedule.</ns0:documentation>
      <ns0:extensionElements>
        <ns2:formDefinition formId="priority-review-form" bindingType="deployment" />
        <ns2:assignmentDefinition candidateGroups="clinical-reviewers" />
        <ns2:userTask />
      </ns0:extensionElements>
      <ns0:incoming>Flow_Priority</ns0:incoming>
      <ns0:outgoing>Flow_Priority_Gateway</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gateway_PriorityOutcome" name="Priority review outcome?" default="Flow_Priority_Escalate">
      <ns0:incoming>Flow_Priority_Gateway</ns0:incoming>
      <ns0:outgoing>Flow_Priority_Proceed</ns0:outgoing>
      <ns0:outgoing>Flow_Priority_Escalate</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="Task_PrecheckAvailability" name="Pre-check appointment availability (Java worker)"><ns0:extensionElements><ns2:taskDefinition type="check-appointment-availability" retries="3" /></ns0:extensionElements><ns0:incoming>Flow_Routine</ns0:incoming><ns0:incoming>Flow_Priority_Proceed</ns0:incoming><ns0:outgoing>Flow_Precheck_To_Rest</ns0:outgoing></ns0:serviceTask><ns0:serviceTask id="Task_CheckSlots" name="Check appointment slots (REST)">
      <ns0:documentation>Calls the mock scheduling API and maps the slots and availability into process variables.</ns0:documentation>
      <ns0:extensionElements>
        <ns2:taskDefinition type="io.camunda:connector-rest" retries="3" />
        <ns2:ioMapping>
          <ns2:input source="noAuth" target="authentication.type" />
          <ns2:input source="= &quot;POST&quot;" target="method" />
          <ns2:input source="= &quot;http://localhost:8081/api/appointments/check&quot;" target="url" />
          <ns2:input source="= { &quot;Content-Type&quot;: &quot;application/json&quot; }" target="headers" />
          <ns2:input source="= { &quot;patientRef&quot;: patientRef, &quot;appointmentPreference&quot;: appointmentPreference, &quot;forceNoSlots&quot;: forceNoSlots, &quot;simulateFailure&quot;: simulateSchedulingFailure }" target="body" />
          <ns2:input source="= 10" target="connectionTimeoutInSeconds" />
          <ns2:input source="= 20" target="readTimeoutInSeconds" />
        </ns2:ioMapping>
        <ns2:taskHeaders>
          <ns2:header key="resultExpression" value="={appointmentAvailable: response.body.available, availableSlots: response.body.slots, schedulingStatus: response.body.bookingStatus}" />
        </ns2:taskHeaders>
      </ns0:extensionElements>
      <ns0:incoming>Flow_Precheck_To_Rest</ns0:incoming><ns0:outgoing>Flow_CheckSlots_Gateway</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gateway_Slots" name="Appointment slot available?" default="Flow_NoSlots">
      <ns0:incoming>Flow_CheckSlots_Gateway</ns0:incoming>
      <ns0:outgoing>Flow_SlotAvailable</ns0:outgoing>
      <ns0:outgoing>Flow_NoSlots</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="Task_SelectSlot" name="Select appointment slot">
      <ns0:documentation>Select one of the returned availableSlots values in Tasklist.</ns0:documentation>
      <ns0:extensionElements>
        <ns2:formDefinition formId="select-appointment-form" bindingType="deployment" />
        <ns2:assignmentDefinition candidateGroups="scheduling-staff" />
        <ns2:userTask />
      </ns0:extensionElements>
      <ns0:incoming>Flow_SlotAvailable</ns0:incoming>
      <ns0:outgoing>Flow_Select_Book</ns0:outgoing>
    </ns0:userTask>
    <ns0:serviceTask id="Task_BookAppointment" name="Book selected appointment (REST)">
      <ns0:documentation>Books the selected synthetic slot through the mock scheduling API.</ns0:documentation>
      <ns0:extensionElements>
        <ns2:taskDefinition type="io.camunda:connector-rest" retries="3" />
        <ns2:ioMapping>
          <ns2:input source="noAuth" target="authentication.type" />
          <ns2:input source="= &quot;POST&quot;" target="method" />
          <ns2:input source="= &quot;http://localhost:8081/api/appointments/book&quot;" target="url" />
          <ns2:input source="= { &quot;Content-Type&quot;: &quot;application/json&quot; }" target="headers" />
          <ns2:input source="= { &quot;patientRef&quot;: patientRef, &quot;selectedSlot&quot;: selectedSlot, &quot;appointmentPreference&quot;: appointmentPreference, &quot;simulateFailure&quot;: simulateSchedulingFailure }" target="body" />
          <ns2:input source="= 10" target="connectionTimeoutInSeconds" />
          <ns2:input source="= 20" target="readTimeoutInSeconds" />
        </ns2:ioMapping>
        <ns2:taskHeaders>
          <ns2:header key="resultExpression" value="={bookingStatus: response.body.bookingStatus, bookingReference: response.body.bookingReference}" />
        </ns2:taskHeaders>
      </ns0:extensionElements>
      <ns0:incoming>Flow_Select_Book</ns0:incoming>
      <ns0:outgoing>Flow_Book_Gateway</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gateway_Booking" name="Booking successful?" default="Flow_BookingFailed">
      <ns0:incoming>Flow_Book_Gateway</ns0:incoming>
      <ns0:outgoing>Flow_Booked</ns0:outgoing>
      <ns0:outgoing>Flow_BookingFailed</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="Task_NoSlotReview" name="Staff review – no suitable slot">
      <ns0:documentation>Tasklist follow-up when no slot is available or booking fails.</ns0:documentation>
      <ns0:extensionElements>
        <ns2:formDefinition formId="no-slot-review-form" bindingType="deployment" />
        <ns2:assignmentDefinition candidateGroups="scheduling-staff" />
        <ns2:userTask />
      </ns0:extensionElements>
      <ns0:incoming>Flow_NoSlots</ns0:incoming>
      <ns0:incoming>Flow_BookingFailed</ns0:incoming>
      <ns0:outgoing>Flow_NoSlot_End</ns0:outgoing>
    </ns0:userTask>
    <ns0:endEvent id="End_Booked" name="Appointment booked">
      <ns0:incoming>Flow_Booked</ns0:incoming>
    </ns0:endEvent>
    <ns0:endEvent id="End_Urgent" name="Urgent assessment routed to staff">
      <ns0:incoming>Flow_Urgent_End</ns0:incoming>
    </ns0:endEvent>
    <ns0:endEvent id="End_PriorityEscalated" name="Priority case escalated">
      <ns0:incoming>Flow_Priority_Escalate</ns0:incoming>
    </ns0:endEvent>
    <ns0:endEvent id="End_NoSlot" name="Manual scheduling follow-up required">
      <ns0:incoming>Flow_NoSlot_End</ns0:incoming>
    </ns0:endEvent>
    <ns0:endEvent id="End_Invalid" name="Registration incomplete">
      <ns0:incoming>Flow_RegistrationInvalid</ns0:incoming>
    </ns0:endEvent>
    <ns0:sequenceFlow id="Flow_Patient_Start" sourceRef="StartEvent_Patient" targetRef="Task_RegisterPatient" />
    <ns0:sequenceFlow id="Flow_Register_Validate" sourceRef="Task_RegisterPatient" targetRef="Task_ValidateRegistration" />
    <ns0:sequenceFlow id="Flow_Validate_Gateway" sourceRef="Task_ValidateRegistration" targetRef="Gateway_RegistrationValid" />
    <ns0:sequenceFlow id="Flow_RegistrationValid" sourceRef="Gateway_RegistrationValid" targetRef="Task_ClassifyTriage" name="Valid">
      <ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= registrationValid = true</ns0:conditionExpression>
    </ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_RegistrationInvalid" sourceRef="Gateway_RegistrationValid" targetRef="End_Invalid" name="Invalid" />
    <ns0:sequenceFlow id="Flow_DMN_Gateway" sourceRef="Task_ClassifyTriage" targetRef="Gateway_Triage" />
    <ns0:sequenceFlow id="Flow_Urgent" sourceRef="Gateway_Triage" targetRef="Task_UrgentAssessment" name="Urgent">
      <ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= triageCategory = "URGENT_ASSESSMENT"</ns0:conditionExpression>
    </ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Priority" sourceRef="Gateway_Triage" targetRef="Task_PriorityReview" name="Priority">
      <ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= triageCategory = "PRIORITY_REVIEW"</ns0:conditionExpression>
    </ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Routine" sourceRef="Gateway_Triage" targetRef="Task_PrecheckAvailability" name="Routine" />
    <ns0:sequenceFlow id="Flow_Urgent_End" sourceRef="Task_UrgentAssessment" targetRef="End_Urgent" />
    <ns0:sequenceFlow id="Flow_Priority_Gateway" sourceRef="Task_PriorityReview" targetRef="Gateway_PriorityOutcome" />
    <ns0:sequenceFlow id="Flow_Priority_Proceed" sourceRef="Gateway_PriorityOutcome" targetRef="Task_PrecheckAvailability" name="Proceed to scheduling">
      <ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= priorityOutcome = "PROCEED"</ns0:conditionExpression>
    </ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Priority_Escalate" sourceRef="Gateway_PriorityOutcome" targetRef="End_PriorityEscalated" name="Escalate / defer" />
    <ns0:sequenceFlow id="Flow_Precheck_To_Rest" sourceRef="Task_PrecheckAvailability" targetRef="Task_CheckSlots" /><ns0:sequenceFlow id="Flow_CheckSlots_Gateway" sourceRef="Task_CheckSlots" targetRef="Gateway_Slots" />
    <ns0:sequenceFlow id="Flow_SlotAvailable" sourceRef="Gateway_Slots" targetRef="Task_SelectSlot" name="Available">
      <ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= appointmentAvailable = true</ns0:conditionExpression>
    </ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_NoSlots" sourceRef="Gateway_Slots" targetRef="Task_NoSlotReview" name="No slots" />
    <ns0:sequenceFlow id="Flow_Select_Book" sourceRef="Task_SelectSlot" targetRef="Task_BookAppointment" />
    <ns0:sequenceFlow id="Flow_Book_Gateway" sourceRef="Task_BookAppointment" targetRef="Gateway_Booking" />
    <ns0:sequenceFlow id="Flow_Booked" sourceRef="Gateway_Booking" targetRef="End_Booked" name="Booked">
      <ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= bookingStatus = "BOOKED"</ns0:conditionExpression>
    </ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_BookingFailed" sourceRef="Gateway_Booking" targetRef="Task_NoSlotReview" name="Booking failed" />
    <ns0:sequenceFlow id="Flow_NoSlot_End" sourceRef="Task_NoSlotReview" targetRef="End_NoSlot" />
  </ns0:process>
  <ns4:BPMNDiagram id="Diagram_hospitalTriageProcess">
    <ns4:BPMNPlane id="Plane_hospitalTriageProcess" bpmnElement="hospitalTriageProcess">
      <ns4:BPMNShape id="Shape_StartEvent_Patient" bpmnElement="StartEvent_Patient">
        <ns5:Bounds x="80" y="280" width="36" height="36" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_Task_RegisterPatient" bpmnElement="Task_RegisterPatient">
        <ns5:Bounds x="160" y="250" width="205" height="100" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_Task_ValidateRegistration" bpmnElement="Task_ValidateRegistration">
        <ns5:Bounds x="420" y="260" width="195" height="85" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_Gateway_RegistrationValid" bpmnElement="Gateway_RegistrationValid" isMarkerVisible="true">
        <ns5:Bounds x="680" y="280" width="50" height="50" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_Task_ClassifyTriage" bpmnElement="Task_ClassifyTriage">
        <ns5:Bounds x="800" y="260" width="210" height="85" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_Gateway_Triage" bpmnElement="Gateway_Triage" isMarkerVisible="true">
        <ns5:Bounds x="1070" y="280" width="50" height="50" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_Task_UrgentAssessment" bpmnElement="Task_UrgentAssessment">
        <ns5:Bounds x="1190" y="470" width="220" height="105" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_Task_PriorityReview" bpmnElement="Task_PriorityReview">
        <ns5:Bounds x="1190" y="650" width="190" height="100" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_Gateway_PriorityOutcome" bpmnElement="Gateway_PriorityOutcome" isMarkerVisible="true">
        <ns5:Bounds x="1440" y="675" width="50" height="50" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_Task_CheckSlots" bpmnElement="Task_CheckSlots">
        <ns5:Bounds x="1515" y="260" width="215" height="100" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_Gateway_Slots" bpmnElement="Gateway_Slots" isMarkerVisible="true">
        <ns5:Bounds x="1790" y="280" width="50" height="50" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_Task_SelectSlot" bpmnElement="Task_SelectSlot">
        <ns5:Bounds x="1935" y="170" width="190" height="100" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_Task_BookAppointment" bpmnElement="Task_BookAppointment">
        <ns5:Bounds x="2160" y="170" width="220" height="100" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_Gateway_Booking" bpmnElement="Gateway_Booking" isMarkerVisible="true">
        <ns5:Bounds x="2440" y="190" width="50" height="50" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_Task_NoSlotReview" bpmnElement="Task_NoSlotReview">
        <ns5:Bounds x="1940" y="470" width="215" height="105" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_End_Booked" bpmnElement="End_Booked">
        <ns5:Bounds x="2720" y="135" width="36" height="36" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_End_Urgent" bpmnElement="End_Urgent">
        <ns5:Bounds x="1510" y="520" width="36" height="36" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_End_PriorityEscalated" bpmnElement="End_PriorityEscalated">
        <ns5:Bounds x="1660" y="760" width="36" height="36" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_End_NoSlot" bpmnElement="End_NoSlot">
        <ns5:Bounds x="2220" y="535" width="36" height="36" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_End_Invalid" bpmnElement="End_Invalid">
        <ns5:Bounds x="800" y="760" width="36" height="36" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Shape_Task_PrecheckAvailability" bpmnElement="Task_PrecheckAvailability"><ns5:Bounds x="1260" y="260" width="205" height="90" /></ns4:BPMNShape><ns4:BPMNEdge id="Edge_Flow_Patient_Start" bpmnElement="Flow_Patient_Start">
        <ns6:waypoint x="116" y="298" />
        <ns6:waypoint x="160" y="300" />
      </ns4:BPMNEdge>
      <ns4:BPMNEdge id="Edge_Flow_Register_Validate" bpmnElement="Flow_Register_Validate">
        <ns6:waypoint x="365" y="300" />
        <ns6:waypoint x="420" y="302" />
      </ns4:BPMNEdge>
      <ns4:BPMNEdge id="Edge_Flow_Validate_Gateway" bpmnElement="Flow_Validate_Gateway">
        <ns6:waypoint x="615" y="302" />
        <ns6:waypoint x="680" y="305" />
      </ns4:BPMNEdge>
      <ns4:BPMNEdge id="Edge_Flow_RegistrationValid" bpmnElement="Flow_RegistrationValid">
        <ns6:waypoint x="730" y="305" />
        <ns6:waypoint x="800" y="302" />
      </ns4:BPMNEdge>
      <ns4:BPMNEdge id="Edge_Flow_RegistrationInvalid" bpmnElement="Flow_RegistrationInvalid">
        <ns6:waypoint x="705" y="330" />
        <ns6:waypoint x="705" y="780" />
        <ns6:waypoint x="800" y="778" />
      </ns4:BPMNEdge>
      <ns4:BPMNEdge id="Edge_Flow_DMN_Gateway" bpmnElement="Flow_DMN_Gateway">
        <ns6:waypoint x="1010" y="302" />
        <ns6:waypoint x="1070" y="305" />
      </ns4:BPMNEdge>
      <ns4:BPMNEdge id="Edge_Flow_Urgent" bpmnElement="Flow_Urgent">
        <ns6:waypoint x="1120" y="330" />
        <ns6:waypoint x="1120" y="522" />
        <ns6:waypoint x="1190" y="522" />
      </ns4:BPMNEdge>
      <ns4:BPMNEdge id="Edge_Flow_Priority" bpmnElement="Flow_Priority">
        <ns6:waypoint x="1095" y="330" />
        <ns6:waypoint x="1095" y="700" />
        <ns6:waypoint x="1190" y="700" />
      </ns4:BPMNEdge>
      <ns4:BPMNEdge id="Edge_Flow_Routine" bpmnElement="Flow_Routine">
        <ns6:waypoint x="1120" y="305" /><ns6:waypoint x="1260" y="305" /></ns4:BPMNEdge>
      <ns4:BPMNEdge id="Edge_Flow_Urgent_End" bpmnElement="Flow_Urgent_End">
        <ns6:waypoint x="1410" y="522" />
        <ns6:waypoint x="1510" y="538" />
      </ns4:BPMNEdge>
      <ns4:BPMNEdge id="Edge_Flow_Priority_Gateway" bpmnElement="Flow_Priority_Gateway">
        <ns6:waypoint x="1380" y="700" />
        <ns6:waypoint x="1440" y="700" />
      </ns4:BPMNEdge>
      <ns4:BPMNEdge id="Edge_Flow_Priority_Proceed" bpmnElement="Flow_Priority_Proceed">
        <ns6:waypoint x="1490" y="675" /><ns6:waypoint x="1490" y="395" /><ns6:waypoint x="1360" y="395" /><ns6:waypoint x="1360" y="350" /></ns4:BPMNEdge>
      <ns4:BPMNEdge id="Edge_Flow_Priority_Escalate" bpmnElement="Flow_Priority_Escalate">
        <ns6:waypoint x="1465" y="725" />
        <ns6:waypoint x="1465" y="785" />
        <ns6:waypoint x="1660" y="778" />
      </ns4:BPMNEdge>
      <ns4:BPMNEdge id="Edge_Flow_CheckSlots_Gateway" bpmnElement="Flow_CheckSlots_Gateway">
        <ns6:waypoint x="1730" y="310" />
        <ns6:waypoint x="1790" y="305" />
      </ns4:BPMNEdge>
      <ns4:BPMNEdge id="Edge_Flow_SlotAvailable" bpmnElement="Flow_SlotAvailable">
        <ns6:waypoint x="1840" y="280" />
        <ns6:waypoint x="1880" y="220" />
        <ns6:waypoint x="1935" y="220" />
      </ns4:BPMNEdge>
      <ns4:BPMNEdge id="Edge_Flow_NoSlots" bpmnElement="Flow_NoSlots">
        <ns6:waypoint x="1815" y="330" />
        <ns6:waypoint x="1815" y="522" />
        <ns6:waypoint x="1940" y="522" />
      </ns4:BPMNEdge>
      <ns4:BPMNEdge id="Edge_Flow_Select_Book" bpmnElement="Flow_Select_Book">
        <ns6:waypoint x="2125" y="220" />
        <ns6:waypoint x="2160" y="220" />
      </ns4:BPMNEdge>
      <ns4:BPMNEdge id="Edge_Flow_Book_Gateway" bpmnElement="Flow_Book_Gateway">
        <ns6:waypoint x="2380" y="220" />
        <ns6:waypoint x="2440" y="215" />
      </ns4:BPMNEdge>
      <ns4:BPMNEdge id="Edge_Flow_Booked" bpmnElement="Flow_Booked">
        <ns6:waypoint x="2490" y="190" />
        <ns6:waypoint x="2490" y="153" />
        <ns6:waypoint x="2720" y="153" />
      </ns4:BPMNEdge>
      <ns4:BPMNEdge id="Edge_Flow_BookingFailed" bpmnElement="Flow_BookingFailed">
        <ns6:waypoint x="2465" y="240" />
        <ns6:waypoint x="2465" y="522" />
        <ns6:waypoint x="2155" y="522" />
      </ns4:BPMNEdge>
      <ns4:BPMNEdge id="Edge_Flow_NoSlot_End" bpmnElement="Flow_NoSlot_End">
        <ns6:waypoint x="2155" y="522" />
        <ns6:waypoint x="2220" y="553" />
      </ns4:BPMNEdge>
    <ns4:BPMNEdge id="Edge_Flow_Precheck_To_Rest" bpmnElement="Flow_Precheck_To_Rest"><ns6:waypoint x="1465" y="305" /><ns6:waypoint x="1515" y="305" /></ns4:BPMNEdge></ns4:BPMNPlane>
  </ns4:BPMNDiagram>
</ns0:definitions>