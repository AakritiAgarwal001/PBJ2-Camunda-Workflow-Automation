{
  "id": "priority-review-form",
  "type": "default",
  "components": [
    {
      "type": "select",
      "key": "priorityOutcome",
      "label": "Priority review outcome",
      "validate": {
        "required": true
      },
      "values": [
        {
          "label": "Proceed to scheduling",
          "value": "PROCEED"
        },
        {
          "label": "Escalate / defer",
          "value": "ESCALATE"
        }
      ]
    },
    {
      "type": "textarea",
      "key": "staffReviewNotes",
      "label": "Staff review notes",
      "validate": {
        "required": true
      }
    }
  ],
  "schemaVersion": 18,
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0"
}