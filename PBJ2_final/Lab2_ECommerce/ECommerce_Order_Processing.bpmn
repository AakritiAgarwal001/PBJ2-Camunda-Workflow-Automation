<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_ecommerceOrderProcess" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:process id="ecommerceOrderProcess" name="E-Commerce Order Processing and Fulfilment" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Order" name="Order process started">
      <bpmn:outgoing>Flow_OrderStart</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_CaptureOrder" name="Capture customer and order details">
      <bpmn:documentation>Capture synthetic order details and payment token. Never use real credentials.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="order-intake-form" bindingType="deployment" />
        <zeebe:assignmentDefinition candidateGroups="order-operators" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_OrderStart</bpmn:incoming>
      <bpmn:outgoing>Flow_Capture_Validate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ValidateOrder" name="Validate order and calculate total">
      <bpmn:documentation>External Java worker validates fields and calculates orderTotal.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-order" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Capture_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_Validate_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_OrderValid" name="Order valid?" default="Flow_OrderInvalid">
      <bpmn:incoming>Flow_Validate_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_OrderValid</bpmn:outgoing>
      <bpmn:outgoing>Flow_OrderInvalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_CheckInventory" name="Check simulated inventory">
      <bpmn:documentation>External Java worker compares requested quantity with availableStock.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-inventory" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_OrderValid</bpmn:incoming>
      <bpmn:outgoing>Flow_Inventory_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Stock" name="Stock available?" default="Flow_InsufficientStock">
      <bpmn:incoming>Flow_Inventory_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_StockAvailable</bpmn:outgoing>
      <bpmn:outgoing>Flow_InsufficientStock</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Task_DeterminePriority" name="Determine order priority (DMN)">
      <bpmn:documentation>DMN evaluates orderTotal, customerCategory, and deliveryPreference.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="orderPriorityDecision" resultVariable="orderPriority" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StockAvailable</bpmn:incoming>
      <bpmn:outgoing>Flow_DMN_ReviewGateway</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_ManualReview" name="Manual review required?" default="Flow_Priority_Normal">
      <bpmn:incoming>Flow_DMN_ReviewGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Priority_Review</bpmn:outgoing>
      <bpmn:outgoing>Flow_Priority_Normal</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ManualVerification" name="High-value / exception verification">
      <bpmn:documentation>Reviewer records reviewOutcome and comments. Approved orders proceed to payment.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="order-review-form" bindingType="deployment" />
        <zeebe:assignmentDefinition candidateGroups="order-reviewers" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Priority_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_ManualReview_Gateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ReviewOutcome" name="Review approved?" default="Flow_Review_Rejected">
      <bpmn:incoming>Flow_ManualReview_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Review_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ProcessPayment" name="Process simulated payment (REST)">
      <bpmn:documentation>Calls the local mock payment service. Only synthetic test tokens are accepted.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:connector-rest" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="= &quot;POST&quot;" target="method" />
          <zeebe:input source="= &quot;http://localhost:8081/api/payments/charge&quot;" target="url" />
          <zeebe:input source="= { &quot;Content-Type&quot;: &quot;application/json&quot; }" target="headers" />
          <zeebe:input source="= { &quot;customerRef&quot;: customerRef, &quot;productId&quot;: productId, &quot;paymentToken&quot;: paymentToken, &quot;amount&quot;: orderTotal, &quot;simulateFailure&quot;: simulatePaymentFailure, &quot;forceDecline&quot;: forcePaymentDecline }" target="body" />
          <zeebe:input source="= 10" target="connectionTimeoutInSeconds" />
          <zeebe:input source="= 20" target="readTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={paymentStatus: response.body.paymentStatus, paymentReference: response.body.transactionRef}" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Priority_Normal</bpmn:incoming>
      <bpmn:incoming>Flow_Review_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_Payment_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Payment" name="Payment approved?" default="Flow_PaymentDeclined">
      <bpmn:incoming>Flow_Payment_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentApproved</bpmn:outgoing>
      <bpmn:outgoing>Flow_PaymentDeclined</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Fulfilment" name="Order sent to fulfilment">
      <bpmn:incoming>Flow_PaymentApproved</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Invalid" name="Invalid order rejected">
      <bpmn:incoming>Flow_OrderInvalid</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_NoStock" name="Insufficient stock – not fulfilled">
      <bpmn:incoming>Flow_InsufficientStock</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_PaymentDeclined" name="Payment declined">
      <bpmn:incoming>Flow_Review_Rejected</bpmn:incoming>
      <bpmn:incoming>Flow_PaymentDeclined</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_OrderStart" sourceRef="StartEvent_Order" targetRef="Task_CaptureOrder" />
    <bpmn:sequenceFlow id="Flow_Capture_Validate" sourceRef="Task_CaptureOrder" targetRef="Task_ValidateOrder" />
    <bpmn:sequenceFlow id="Flow_Validate_Gateway" sourceRef="Task_ValidateOrder" targetRef="Gateway_OrderValid" />
    <bpmn:sequenceFlow id="Flow_OrderValid" sourceRef="Gateway_OrderValid" targetRef="Task_CheckInventory" name="Valid">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= orderValid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_OrderInvalid" sourceRef="Gateway_OrderValid" targetRef="End_Invalid" name="Invalid" />
    <bpmn:sequenceFlow id="Flow_Inventory_Gateway" sourceRef="Task_CheckInventory" targetRef="Gateway_Stock" />
    <bpmn:sequenceFlow id="Flow_StockAvailable" sourceRef="Gateway_Stock" targetRef="Task_DeterminePriority" name="Available">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= stockAvailable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_InsufficientStock" sourceRef="Gateway_Stock" targetRef="End_NoStock" name="Insufficient" />
    <bpmn:sequenceFlow id="Flow_DMN_ReviewGateway" sourceRef="Task_DeterminePriority" targetRef="Gateway_ManualReview" />
    <bpmn:sequenceFlow id="Flow_Priority_Review" sourceRef="Gateway_ManualReview" targetRef="Task_ManualVerification" name="High value / exception">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= orderTotal &gt;= 2000 or orderPriority = "HIGH"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Priority_Normal" sourceRef="Gateway_ManualReview" targetRef="Task_ProcessPayment" name="Normal priority" />
    <bpmn:sequenceFlow id="Flow_ManualReview_Gateway" sourceRef="Task_ManualVerification" targetRef="Gateway_ReviewOutcome" />
    <bpmn:sequenceFlow id="Flow_Review_Approved" sourceRef="Gateway_ReviewOutcome" targetRef="Task_ProcessPayment" name="Approved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reviewOutcome = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Review_Rejected" sourceRef="Gateway_ReviewOutcome" targetRef="End_PaymentDeclined" name="Rejected" />
    <bpmn:sequenceFlow id="Flow_Payment_Gateway" sourceRef="Task_ProcessPayment" targetRef="Gateway_Payment" />
    <bpmn:sequenceFlow id="Flow_PaymentApproved" sourceRef="Gateway_Payment" targetRef="End_Fulfilment" name="Approved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentStatus = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PaymentDeclined" sourceRef="Gateway_Payment" targetRef="End_PaymentDeclined" name="Declined" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_ecommerceOrderProcess">
    <bpmndi:BPMNPlane id="Plane_ecommerceOrderProcess" bpmnElement="ecommerceOrderProcess">
      <bpmndi:BPMNShape id="Shape_StartEvent_Order" bpmnElement="StartEvent_Order">
        <dc:Bounds x="90" y="255" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_CaptureOrder" bpmnElement="Task_CaptureOrder">
        <dc:Bounds x="170" y="225" width="210" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ValidateOrder" bpmnElement="Task_ValidateOrder">
        <dc:Bounds x="430" y="235" width="200" height="85" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_OrderValid" bpmnElement="Gateway_OrderValid" isMarkerVisible="true">
        <dc:Bounds x="690" y="255" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_CheckInventory" bpmnElement="Task_CheckInventory">
        <dc:Bounds x="810" y="235" width="190" height="85" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Stock" bpmnElement="Gateway_Stock" isMarkerVisible="true">
        <dc:Bounds x="1060" y="255" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_DeterminePriority" bpmnElement="Task_DeterminePriority">
        <dc:Bounds x="1180" y="235" width="205" height="85" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_ManualReview" bpmnElement="Gateway_ManualReview" isMarkerVisible="true">
        <dc:Bounds x="1445" y="255" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ManualVerification" bpmnElement="Task_ManualVerification">
        <dc:Bounds x="1515" y="440" width="220" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_ReviewOutcome" bpmnElement="Gateway_ReviewOutcome" isMarkerVisible="true">
        <dc:Bounds x="1800" y="465" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ProcessPayment" bpmnElement="Task_ProcessPayment">
        <dc:Bounds x="1990" y="235" width="220" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Payment" bpmnElement="Gateway_Payment" isMarkerVisible="true">
        <dc:Bounds x="2265" y="255" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Fulfilment" bpmnElement="End_Fulfilment">
        <dc:Bounds x="2500" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Invalid" bpmnElement="End_Invalid">
        <dc:Bounds x="2500" y="380" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_NoStock" bpmnElement="End_NoStock">
        <dc:Bounds x="2500" y="500" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_PaymentDeclined" bpmnElement="End_PaymentDeclined">
        <dc:Bounds x="2500" y="620" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_OrderStart" bpmnElement="Flow_OrderStart">
        <di:waypoint x="126" y="273" />
        <di:waypoint x="170" y="275" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Capture_Validate" bpmnElement="Flow_Capture_Validate">
        <di:waypoint x="380" y="275" />
        <di:waypoint x="430" y="277" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Validate_Gateway" bpmnElement="Flow_Validate_Gateway">
        <di:waypoint x="630" y="277" />
        <di:waypoint x="690" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_OrderValid" bpmnElement="Flow_OrderValid">
        <di:waypoint x="740" y="280" />
        <di:waypoint x="810" y="277" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_OrderInvalid" bpmnElement="Flow_OrderInvalid">
        <di:waypoint x="715" y="305" />
        <di:waypoint x="715" y="420" />
        <di:waypoint x="2500" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Inventory_Gateway" bpmnElement="Flow_Inventory_Gateway">
        <di:waypoint x="1000" y="277" />
        <di:waypoint x="1060" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_StockAvailable" bpmnElement="Flow_StockAvailable">
        <di:waypoint x="1110" y="280" />
        <di:waypoint x="1180" y="277" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_InsufficientStock" bpmnElement="Flow_InsufficientStock">
        <di:waypoint x="1085" y="305" />
        <di:waypoint x="1085" y="540" />
        <di:waypoint x="2500" y="540" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_DMN_ReviewGateway" bpmnElement="Flow_DMN_ReviewGateway">
        <di:waypoint x="1385" y="277" />
        <di:waypoint x="1445" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Priority_Review" bpmnElement="Flow_Priority_Review">
        <di:waypoint x="1495" y="305" />
        <di:waypoint x="1495" y="490" />
        <di:waypoint x="1515" y="490" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Priority_Normal" bpmnElement="Flow_Priority_Normal">
        <di:waypoint x="1470" y="255" />
        <di:waypoint x="1470" y="180" />
        <di:waypoint x="1990" y="180" />
        <di:waypoint x="1990" y="285" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_ManualReview_Gateway" bpmnElement="Flow_ManualReview_Gateway">
        <di:waypoint x="1735" y="490" />
        <di:waypoint x="1800" y="490" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Review_Approved" bpmnElement="Flow_Review_Approved">
        <di:waypoint x="1850" y="465" />
        <di:waypoint x="1900" y="465" />
        <di:waypoint x="1900" y="285" />
        <di:waypoint x="1990" y="285" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Review_Rejected" bpmnElement="Flow_Review_Rejected">
        <di:waypoint x="1825" y="515" />
        <di:waypoint x="1825" y="650" />
        <di:waypoint x="2500" y="638" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Payment_Gateway" bpmnElement="Flow_Payment_Gateway">
        <di:waypoint x="2210" y="285" />
        <di:waypoint x="2265" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_PaymentApproved" bpmnElement="Flow_PaymentApproved">
        <di:waypoint x="2315" y="255" />
        <di:waypoint x="2315" y="178" />
        <di:waypoint x="2500" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_PaymentDeclined" bpmnElement="Flow_PaymentDeclined">
        <di:waypoint x="2315" y="305" />
        <di:waypoint x="2315" y="638" />
        <di:waypoint x="2500" y="638" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>