<?xml version='1.0' encoding='utf-8'?>
<ns0:definitions xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:ns0="https://www.omg.org/spec/DMN/20191111/MODEL/" id="Definitions_orderPriorityDecision" name="Order Priority Decision" namespace="http://camunda.org/schema/1.0/dmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <ns0:decision id="orderPriorityDecision" name="Order Priority Decision">
    <ns0:decisionTable id="DecisionTable_orderPriorityDecision" hitPolicy="FIRST">
      <ns0:input id="Input_1" label="Order total">
        <ns0:inputExpression id="InputExpression_1" typeRef="number">
          <ns0:text>orderTotal</ns0:text>
        </ns0:inputExpression>
      </ns0:input>
      <ns0:input id="Input_2" label="Customer category">
        <ns0:inputExpression id="InputExpression_2" typeRef="string">
          <ns0:text>customerCategory</ns0:text>
        </ns0:inputExpression>
      </ns0:input>
      <ns0:input id="Input_3" label="Delivery preference">
        <ns0:inputExpression id="InputExpression_3" typeRef="string">
          <ns0:text>deliveryPreference</ns0:text>
        </ns0:inputExpression>
      </ns0:input>
      <ns0:output id="Output_1" name="orderPriorityDecision" label="Order priority" typeRef="string" />
      <ns0:rule id="Rule_1">
        <ns0:description>Very high order value gets high priority.</ns0:description>
        <ns0:inputEntry id="Rule_1_Input_1">
          <ns0:text>&gt;= 2000</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="Rule_1_Input_2">
          <ns0:text>-</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="Rule_1_Input_3">
          <ns0:text>-</ns0:text>
        </ns0:inputEntry>
        <ns0:outputEntry id="Rule_1_Output">
          <ns0:text>"HIGH"</ns0:text>
        </ns0:outputEntry>
      </ns0:rule>
      <ns0:rule id="Rule_2">
        <ns0:description>Premium customer with material order value gets high priority.</ns0:description>
        <ns0:inputEntry id="Rule_2_Input_1">
          <ns0:text>&gt;= 1000</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="Rule_2_Input_2">
          <ns0:text>"PREMIUM"</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="Rule_2_Input_3">
          <ns0:text>-</ns0:text>
        </ns0:inputEntry>
        <ns0:outputEntry id="Rule_2_Output">
          <ns0:text>"HIGH"</ns0:text>
        </ns0:outputEntry>
      </ns0:rule>
      <ns0:rule id="Rule_3">
        <ns0:description>Express delivery preference gets high priority.</ns0:description>
        <ns0:inputEntry id="Rule_3_Input_1">
          <ns0:text>-</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="Rule_3_Input_2">
          <ns0:text>-</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="Rule_3_Input_3">
          <ns0:text>"EXPRESS"</ns0:text>
        </ns0:inputEntry>
        <ns0:outputEntry id="Rule_3_Output">
          <ns0:text>"HIGH"</ns0:text>
        </ns0:outputEntry>
      </ns0:rule>
      <ns0:rule id="Rule_4">
        <ns0:description>All other orders use normal priority.</ns0:description>
        <ns0:inputEntry id="Rule_4_Input_1">
          <ns0:text>-</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="Rule_4_Input_2">
          <ns0:text>-</ns0:text>
        </ns0:inputEntry>
        <ns0:inputEntry id="Rule_4_Input_3">
          <ns0:text>-</ns0:text>
        </ns0:inputEntry>
        <ns0:outputEntry id="Rule_4_Output">
          <ns0:text>"NORMAL"</ns0:text>
        </ns0:outputEntry>
      </ns0:rule>
    </ns0:decisionTable>
  </ns0:decision>
</ns0:definitions>